#!/bin/zsh
# BootstrapMate postinstall
# Sets up symlink, log directory, and loads the LaunchDaemon

set -e

# BOOTSTRAPMATE_TEST_ROOT runs this script against a scratch directory instead
# of the boot volume: every path is prefixed with it and launchd is left alone.
# The installer never sets it.
ROOT="${BOOTSTRAPMATE_TEST_ROOT:-}"
POSTINSTALL_LOG="${ROOT}/tmp/bootstrapmate-postinstall.log"

# Debug logging function
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "${POSTINSTALL_LOG}"
}

# launchctl, skipped under a test root so a test never touches the real jobs.
launchctl_run() {
    if [[ -n "${ROOT}" ]]; then
        log "(test root) skipped: launchctl $*"
        return 0
    fi
    /bin/launchctl "$@"
}

log "=== BootstrapMate postinstall started ==="

APP_PATH="${ROOT}/Applications/Utilities/Managed Bootstrap Install.app"
# The app was BootstrapMate.app before the rename; an upgrade removes it.
LEGACY_APP_PATH="${ROOT}/Applications/Utilities/BootstrapMate.app"
BINARY_PATH="${APP_PATH}/Contents/MacOS/managedbootstrapinstall"
SYMLINK_DIR="${ROOT}/usr/local/bootstrapmate"
SYMLINK_PATH="${SYMLINK_DIR}/managedbootstrapinstall"
# On PATH, the way other management tools expose a CLI that lives in an app bundle.
PATH_SYMLINK="${ROOT}/usr/local/bin/managedbootstrapinstall"
LAUNCHDAEMON_PATH="${ROOT}/Library/LaunchDaemons/com.github.bootstrapmate.plist"

# Managed Bootstrap directory structure
MANAGED_DIR="${ROOT}/Library/Managed Bootstrap"
LOG_DIR="${MANAGED_DIR}/logs"
CACHE_DIR="${MANAGED_DIR}/cache"

log "Creating directories..."

# Create Managed Bootstrap directories FIRST (before daemon can start)
mkdir -p "${LOG_DIR}"
chmod 755 "${LOG_DIR}"
mkdir -p "${CACHE_DIR}"
chmod 755 "${CACHE_DIR}"

log "Directories created: LOG_DIR=${LOG_DIR}, CACHE_DIR=${CACHE_DIR}"

# Verify binary was installed in app bundle
if [[ -x "${BINARY_PATH}" ]]; then
    log "Binary found: ${BINARY_PATH}"
    
    # Get binary info
    log "Binary architecture: $(file "${BINARY_PATH}")"
    
    # Create symlink directory and symlink
    rm -f "${SYMLINK_DIR}/.placeholder" 2>/dev/null || true
    mkdir -p "${SYMLINK_DIR}"
    ln -sf "${BINARY_PATH}" "${SYMLINK_PATH}"
    log "Symlink created: ${SYMLINK_PATH} -> ${BINARY_PATH}"
    mkdir -p "$(dirname "${PATH_SYMLINK}")"
    ln -sf "${BINARY_PATH}" "${PATH_SYMLINK}"
    log "Symlink created: ${PATH_SYMLINK} -> ${BINARY_PATH}"

    # Hard cut: drop the legacy installapplications symlink from prior versions
    rm -f "${SYMLINK_DIR}/installapplications" 2>/dev/null || true
    
    # Verify symlink works
    if [[ -x "${SYMLINK_PATH}" ]]; then
        log "Symlink is executable"
        VER=$("${SYMLINK_PATH}" --version 2>&1 || echo "version check failed")
        log "Version: ${VER}"
    else
        log "ERROR: Symlink is not executable!"
    fi
    
    # Set permissions on LaunchDaemon
    if [[ -f "${LAUNCHDAEMON_PATH}" ]]; then
        chmod 644 "${LAUNCHDAEMON_PATH}"
        chown root:wheel "${LAUNCHDAEMON_PATH}" 2>/dev/null || [[ -n "${ROOT}" ]]
        log "LaunchDaemon permissions set"
        
        # Boot out any previously loaded job first: launchctl load no-ops when the
        # label is already loaded, which on an upgrade would leave launchd pointing
        # at the old executable path (the binary was renamed). Boot out, then load.
        log "Loading LaunchDaemon..."
        launchctl_run bootout system/com.github.bootstrapmate 2>/dev/null || true
        launchctl_run load -w "${LAUNCHDAEMON_PATH}" 2>&1 | tee -a "${POSTINSTALL_LOG}" || log "launchctl load returned non-zero"
        log "LaunchDaemon load attempted"
    else
        log "ERROR: LaunchDaemon plist not found: ${LAUNCHDAEMON_PATH}"
    fi
    
    log "BootstrapMate installed successfully"

    # Register the XPC privileged helper daemon via SMAppService
    # The helper plist is embedded at Contents/Library/LaunchDaemons/
    # inside the app bundle. SMAppService reads it from there on macOS 13+.
    HELPER_LD_PATH="${APP_PATH}/Contents/Library/LaunchDaemons/com.github.bootstrapmate.helper.plist"
    HELPER_SYSTEM_PLIST="${ROOT}/Library/LaunchDaemons/com.github.bootstrapmate.helper.plist"
    # launchd runs the helper from the boot volume, so its path never carries
    # the test root.
    HELPER_BINARY="${APP_PATH#${ROOT}}/Contents/MacOS/BootstrapMateHelper"
    if [[ -f "${HELPER_LD_PATH}" ]]; then
        log "Helper LaunchDaemon plist found at ${HELPER_LD_PATH}"
        # Copy plist and convert BundleProgram to ProgramArguments for launchd
        cp "${HELPER_LD_PATH}" "${HELPER_SYSTEM_PLIST}"
        # Remove the BundleProgram key (SMAppService-only) and add ProgramArguments
        /usr/libexec/PlistBuddy -c "Delete :BundleProgram" "${HELPER_SYSTEM_PLIST}" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :ProgramArguments array" "${HELPER_SYSTEM_PLIST}" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Add :ProgramArguments:0 string ${HELPER_BINARY}" "${HELPER_SYSTEM_PLIST}" 2>/dev/null || true
        chmod 644 "${HELPER_SYSTEM_PLIST}"
        chown root:wheel "${HELPER_SYSTEM_PLIST}" 2>/dev/null || [[ -n "${ROOT}" ]]
        # Unload if previously loaded, then bootstrap
        launchctl_run bootout system/com.github.bootstrapmate.helper 2>/dev/null || true
        launchctl_run bootstrap system "${HELPER_SYSTEM_PLIST}" 2>&1 | tee -a "${POSTINSTALL_LOG}" || log "helper launchctl bootstrap returned non-zero (may already be loaded)"
        log "Helper daemon registration attempted"
    else
        log "WARNING: Helper LaunchDaemon plist not found: ${HELPER_LD_PATH}"
    fi

    # Remove the pre-rename app last, once the new binary is in place and both
    # jobs have been booted out of it and reloaded from the new path, so a
    # Mac is never left with two apps or with none.
    if [[ -d "${LEGACY_APP_PATH}" ]]; then
        rm -rf "${LEGACY_APP_PATH}"
        log "Removed pre-rename app bundle: ${LEGACY_APP_PATH}"
    fi
else
    log "ERROR: BootstrapMate binary not found at ${BINARY_PATH}"
    exit 1
fi

log "=== BootstrapMate postinstall completed ==="

exit 0
